                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "stashID",
                  "description": "(Required) Client-generated identifier for the stash."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "serial",
                  "description": "(Required) Zero-based serial number of this chunk within the stash."
                }
